   "source": [
    "from pyspark.sql.functions import *\n",
    "df = spark.range(0,100)\n",
    "df = df.withColumn(\"square\", col(\"id\") * col(\"id\"))\n",
    "result = df.groupBy( col(\"id\")%100 ).agg( sum(\"square\").alias(\"sum_square\") )\n",
    "display(result)"
   ]
